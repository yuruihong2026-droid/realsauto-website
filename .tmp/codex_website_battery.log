/bin/zsh -lc "python3 - <<'PY'
from pathlib import Path
files = [
 'automotive-fleece-tape.html','polyester-fabric-tape.html','pvc-wire-harness-tape.html',
 'aluminum-foil-fiberglass-tape.html','automotive-cable-clips-ties.html','expandable-braided-sleeving.html'
]
for name in files:
    p=Path(name)
    text=p.read_text()
    count=text.count('../')
    p.write_text(text.replace('../',''))
    print(f'{name}: fixed {count} root-relative references')
PY
python3 - <<'PY'
from html.parser import HTMLParser
from pathlib import Path
from urllib.parse import urlsplit, unquote
class P(HTMLParser):
    def __init__(self): super().__init__(); self.links=[]
    def handle_starttag(self, tag, attrs):
        d=dict(attrs)
        for key in ('href','src'):
            if key in d: self.links.append(d[key])
missing=[]
for page in Path('.').glob('*.html'):
    p=P(); p.feed(page.read_text())
    for raw in p.links:
        u=urlsplit(raw)
        if u.scheme or raw.startswith('//') or raw.startswith('mailto:') or raw.startswith('tel:') or raw.startswith('data:'): continue
        target=(page.parent / unquote(u.path)).resolve() if u.path else page.resolve()
        if not target.exists(): missing.append((page.name,raw))
if missing:
    print(*missing,sep='\\n'); raise SystemExit(1)
print('all local href/src targets exist')
PY
