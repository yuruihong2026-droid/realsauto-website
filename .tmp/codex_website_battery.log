.process-strip{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid rgba(7,19,29,.14)}.process-card{position:relative;min-height:420px;overflow:hidden;border-right:1px solid rgba(7,19,29,.14)}.process-card:last-child{border-right:0}.process-card img{width:100%;height:100%;object-fit:cover;filter:saturate(.6) contrast(1.05);transition:.55s}.process-card:after{content:"";position:absolute;inset:0;background:linear-gradient(transparent 30%,rgba(4,14,20,.91))}.process-card:hover img{transform:scale(1.06);filter:saturate(1)}.process-card>span{position:absolute;top:20px;left:20px;z-index:2;color:#fff;font-size:11px}.process-card>div{position:absolute;left:24px;right:24px;bottom:23px;z-index:2;color:#fff}.process-card small{text-transform:uppercase;letter-spacing:.15em;color:var(--green)}.process-card h3{font-size:20px;line-height:1.2;margin:8px 0 0}
