+  <script type="application/ld+json">{"@context":"https://schema.org","@type":"CollectionPage","name":"Battery Protection Materials for Cell and Pack Manufacturing","url":"https://www.realsauto.com/battery-protection.html","description":"Electrical insulation and flame-retardant tape materials for battery cell and pack manufacturing, produced by qualified manufacturing partners to REALS specification.","isPartOf":{"@type":"WebSite","name":"REALS","url":"https://www.realsauto.com/"}}</script>
+  <script type="application/ld+json">{"@context":"https://schema.org","@type":"ItemList","name":"Battery Protection Product Categories","numberOfItems":2,"itemListElement":[{"@type":"ListItem","position":1,"name":"Electrical Insulation Tapes","url":"https://www.realsauto.com/battery-protection.html#insulation"},{"@type":"ListItem","position":2,"name":"Flame-Retardant Tapes","url":"https://www.realsauto.com/battery-protection.html#flame"}]}</script>
+  <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Who produces REALS battery protection materials?","acceptedAnswer":{"@type":"Answer","text":"They are produced by our qualified manufacturing partners to REALS specification."}},{"@type":"Question","name":"Can you work from our drawing?","acceptedAnswer":{"@type":"Answer","text":"Yes. Send the drawing and application location for specification review."}},{"@type":"Question","name":"Are samples available?","acceptedAnswer":{"@type":"Answer","text":"Samples can be arranged after the specification is confirmed."}},{"@type":"Question","name":"What documents can you share?","acceptedAnswer":{"@type":"Answer","text":"We can share material data sheets, dimensional drawings and available test reports from our manufacturing partner."}},{"@type":"Question","name":"Do you claim a specific certification or performance level?","acceptedAnswer":{"@type":"Answer","text":"No unverified claim is made. Applicable documentation is reviewed against the confirmed specification."}}]}</script>
+  <!-- Google tag (gtag.js) -->
+  <script async src="https://www.googletagmanager.com/gtag/js?id=G-5NRTTVTR7C"></script>
