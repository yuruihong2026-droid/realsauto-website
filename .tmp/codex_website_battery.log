 .contact-layout{display:grid;grid-template-columns:.75fr 1.25fr;gap:7vw}.contact-info h2{font-size:50px;line-height:1.05}.contact-info p{color:#516066}.contact-card{margin-top:35px;border-top:1px solid rgba(7,19,29,.15)}.contact-card div{padding:17px 0;border-bottom:1px solid rgba(7,19,29,.15)}.contact-card small{display:block;text-transform:uppercase;letter-spacing:.14em;color:#7c8b90;font-size:9px}.contact-card a,.contact-card span{font-size:15px}.inquiry-form{background:#0b2029;padding:42px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.field{display:flex;flex-direction:column;gap:7px}.field.full{grid-column:1/-1}.field label{font-size:9px;text-transform:uppercase;letter-spacing:.14em;color:#9fb0b3}.field input,.field select,.field textarea{background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.16);color:#fff;padding:13px;outline:none}.field select option{color:#111}.field textarea{min-height:130px;resize:vertical}.form-note{font-size:10px;color:#7e9195;margin-top:15px}.form-status{display:none;color:var(--green);margin-top:14px;font-size:12px}
