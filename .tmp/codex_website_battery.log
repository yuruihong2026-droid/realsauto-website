        target=(page.parent / unquote(u.path)).resolve() if u.path else page.resolve()
        if not target.exists(): missing.append((page.name,raw,str(target)))
if missing:
    for x in missing: print('MISSING',*x)
    raise SystemExit(1)
print('all local href/src targets exist')
