.conversion-section{padding-top:80px;padding-bottom:80px}.conversion-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:7vw;align-items:start}.conversion-copy h2,.video-section h2{font-size:clamp(34px,4vw,58px);line-height:1.05;margin:14px 0}.conversion-copy p{color:#526167}.compact-inquiry{padding:34px}.compact-inquiry .form-grid{grid-template-columns:1fr 1fr}.compact-inquiry button,.tds-form button{min-height:44px}.field input,.field textarea{min-height:44px}.form-status a{text-decoration:underline}.engineer-row{display:flex;flex-wrap:wrap;gap:12px;margin-top:22px}
.download-row .tds-trigger{font-size:10px;text-transform:uppercase;letter-spacing:.12em;border:1px solid rgba(7,19,29,.24);padding:10px 13px;cursor:pointer;background:transparent;color:var(--ink);line-height:inherit}.download-row .tds-trigger:hover{background:var(--ink);color:#fff}.download-row .tds-trigger[aria-disabled="true"]{opacity:.55}.conversion-copy .btn-ghost{color:var(--ink);border-color:rgba(7,19,29,.35)}.conversion-copy .btn-ghost:hover{color:var(--ink);border-color:var(--green)}.tds-dialog{width:min(520px,calc(100% - 32px));border:0;padding:0;background:#0b2029;color:#fff;box-shadow:var(--shadow)}.tds-dialog::backdrop{background:rgba(2,10,16,.76)}.tds-dialog-inner{padding:32px;position:relative}.tds-dialog h2{margin:0 42px 18px 0;font-size:28px}.tds-close{position:absolute;right:16px;top:14px;width:44px;height:44px;border:0;background:transparent;color:#fff;font-size:28px;cursor:pointer}.tds-form .form-grid{grid-template-columns:1fr}.tds-confirmation{color:var(--green);margin:12px 0 0}
.video-section{padding-top:80px;padding-bottom:80px}.video-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.video-card{margin:0;min-width:0}.video-frame{position:relative;aspect-ratio:9/16;background:#132631;border-radius:14px;overflow:hidden}.video-frame video{display:none;width:100%;height:100%;object-fit:cover}.video-frame.is-ready video{display:block}.video-frame.is-ready .video-placeholder{display:none}.video-cover,.video-placeholder{position:absolute;inset:0;width:100%;height:100%;border:0;padding:0;display:grid;place-items:center;background:#132631;overflow:hidden}.video-cover{z-index:3;cursor:pointer;color:#fff}.video-cover img,.video-placeholder img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.video-cover::before,.video-placeholder::before{content:"";position:absolute;z-index:1;inset:0;background:linear-gradient(rgba(5,18,28,.18),rgba(5,18,28,.62))}.video-cover span,.video-placeholder span{position:relative;z-index:2;border:1px solid rgba(255,255,255,.55);padding:11px 17px;color:#fff;text-transform:uppercase;letter-spacing:.12em;font-size:11px}.video-cover[hidden]{display:none}.video-card figcaption{margin-top:12px;color:inherit}.video-card figcaption h3{font-size:16px;line-height:1.2;margin:0 0 3px}.video-card figcaption p{font-size:12px;line-height:1.45;color:#aebbc0;margin:0}.trust-strip{padding:14px 8vw;background:var(--green);color:var(--ink);font-size:12px;font-weight:700;text-align:center;letter-spacing:.04em}
.video-card-coming .video-frame{aspect-ratio:auto;min-height:150px;background:linear-gradient(135deg,rgba(120,216,27,.16),rgba(42,120,255,.12));border:1px dashed rgba(120,216,27,.5)}.video-card-coming .video-placeholder{background:transparent}.video-card-coming .video-placeholder img{display:none}.video-card-coming .video-placeholder::before{display:none}.video-card-coming .video-placeholder span{border-color:var(--green);color:var(--green)}
